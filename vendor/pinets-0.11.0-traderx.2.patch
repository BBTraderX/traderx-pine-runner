index 0000000..83a102f
--- /dev/null
+++ b/tests/namespaces/request-security-inputs-cache.test.ts
@@ -0,0 +1,150 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+/**
+ * request.security and inputs:
+ *
+ *   - An input override reaches the secondary (the requested timeframe sees the
+ *     same settings as the chart).
+ *   - A slice keeps only the statements its call depends on.
+ *   - With a securityCache, a secondary's result is reused across runs while the
+ *     inputs it depends on keep their values.
+ *
+ * References are independent of the code under test: a script whose default IS
+ * the overridden value, and the same request made without a helper function.
+ */
+
+import { describe, it, expect } from 'vitest';
+import { PineTS, Provider, Indicator } from 'index';
+import { transpile } from '../../src/transpiler/index';
+
+const chartStart = new Date('2018-12-15').getTime();
+const chartEnd = new Date('2019-03-15').getTime();
+const makePineTS = () => new PineTS(Provider.Mock, 'BTCUSDC', 'D', null, chartStart, chartEnd);
+// The mock data has 1h, 4h and 1d bars from 2024.
+const makeHourly = () =>
+    new PineTS(Provider.Mock, 'BTCUSDC', '60', null, new Date('2024-03-01').getTime(), new Date('2024-03-20').getTime());
+
+const values = (ctx: any, title: string) => ctx.plots[title].data.map((p: any) => p.value);
+
+const withLen = (len: number) => `
+//@version=5
+indicator("inputs reach security")
+len = input.int(${len}, "Len")
+f(tf) => request.security(syminfo.tickerid, tf, ta.sma(close, len))
+plot(request.security(syminfo.tickerid, "W", ta.sma(close, len)), "Direct")
+plot(f("W"), "InFn")
+`;
+
+describe('request.security with inputs', () => {
+    it('an input override reaches the requested timeframe', async () => {
+        const overridden = await makePineTS().run(new Indicator(withLen(3), { Len: 6 }));
+        const reference = await makePineTS().run(withLen(6));
+        const defaults = await makePineTS().run(withLen(3));
+
+        expect(values(overridden, 'Direct')).toEqual(values(reference, 'Direct'));
+        expect(values(overridden, 'InFn')).toEqual(values(reference, 'InFn'));
+        // And the override changed something, so the comparison means something.
+        expect(values(overridden, 'Direct')).not.toEqual(values(defaults, 'Direct'));
+    });
+
+    it("a call site's slice keeps only the statements its call depends on", () => {
+        const code = `
+//@version=5
+indicator("pruned slices")
+len = input.int(4, "Len")
+style = input.string("a", "Style")
+f(tf) => request.security(syminfo.tickerid, tf, ta.sma(close, len))
+a = f("W")
+unrelated = ta.ema(close, 9) + (style == "a" ? 1 : 2)
+b = f("M")
+plot(a, "A")
+plot(b, "B")
+`;
+        const fn = transpile(code) as any;
+        const sites = Object.keys(fn._ltfSlices).filter((k) => /^_fn\d+p\d+$/.test(k));
+        expect(sites.length).toBe(2);
+        const [first, second] = sites.map((k) => fn._ltfSlices[k].toString());
+        // The second call site's slice needs len, not the first call, the EMA or the Style input.
+        expect(second).toMatch(/glb1_len/);
+        expect(second).not.toMatch(/glb1_a\b/);
+        expect(second).not.toMatch(/glb1_unrelated/);
+        expect(second).not.toMatch(/glb1_style/);
+        expect(first).not.toMatch(/glb1_style/);
+    });
+
+    it('pruned slices give the same values as the same requests made directly', async () => {
+        const viaFn = await makePineTS().run(`
+//@version=5
+indicator("via fn")
+len = input.int(4, "Len")
+f(tf) => request.security(syminfo.tickerid, tf, ta.sma(close, len))
+a = f("W")
+noise = ta.ema(close, 9)
+b = f("M")
+plot(a, "A")
+plot(b, "B")
+`);
+        const direct = await makePineTS().run(`
+//@version=5
+indicator("direct")
+len = input.int(4, "Len")
+plot(request.security(syminfo.tickerid, "W", ta.sma(close, len)), "A")
+plot(request.security(syminfo.tickerid, "M", ta.sma(close, len)), "B")
+`);
+        expect(values(viaFn, 'A')).toEqual(values(direct, 'A'));
+        expect(values(viaFn, 'B')).toEqual(values(direct, 'B'));
+    });
+
+    it('a securityCache reuses a secondary while the inputs it depends on are unchanged', async () => {
+        const code = `
+//@version=5
+indicator("cached")
+len = input.int(4, "Len")
+style = input.string("a", "Style")
+f(tf) => request.security(syminfo.tickerid, tf, ta.sma(close, len))
+shown = style == "a" ? 1 : 2
+plot(f("240"), "H4")
+plot(f("D"), "D")
+plot(shown, "Shown")
+`;
+        const entries = new Map<string, any[]>();
+        let stored = 0;
+        const store = {
+            get: async (parts: any) => entries.get(JSON.stringify(parts)),
+            set: async (parts: any, entry: any) => {
+                stored++;
+                const key = JSON.stringify(parts);
+                entries.set(key, [entry, ...(entries.get(key) ?? [])]);
+            },
+        };
+        const run = async (inputs: Record<string, unknown>) => {
+            const pine = makeHourly();
+            pine.securityCache = store;
+            return pine.run(new Indicator(code, inputs));
+        };
+
+        const first = await run({});
+        expect(stored).toBe(2);
+
+        // Style feeds neither request: both are reused, and the result is what a fresh run gives.
+        const styled = await run({ Style: 'b' });
+        expect(stored).toBe(2);
+        const freshStyled = await makeHourly().run(new Indicator(code, { Style: 'b' }));
+        expect(values(styled, 'H4')).toEqual(values(freshStyled, 'H4'));
+        expect(values(styled, 'D')).toEqual(values(freshStyled, 'D'));
+        expect(values(styled, 'Shown')).toEqual(values(freshStyled, 'Shown'));
+        expect(values(styled, 'H4')).toEqual(values(first, 'H4'));
+
+        // Len feeds both: both run again, with the new length.
+        const longer = await run({ Len: 7 });
+        expect(stored).toBe(4);
+        const freshLonger = await makeHourly().run(new Indicator(code, { Len: 7 }));
+        expect(values(longer, 'H4')).toEqual(values(freshLonger, 'H4'));
+        expect(values(longer, 'D')).toEqual(values(freshLonger, 'D'));
+        expect(values(longer, 'H4')).not.toEqual(values(first, 'H4'));
+
+        // Back to the first settings: reused again.
+        await run({ Style: 'a', Len: 4 });
+        expect(stored).toBe(4);
+    });
+});
