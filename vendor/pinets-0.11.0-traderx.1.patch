From 5f6b9ba83981ab9738a71127c8f90a1c0b9a40b2 Mon Sep 17 00:00:00 2001
From: BB TraderX <contactmired@gmail.com>
Date: Thu, 15 Oct 2026 16:43:27 -0500
Subject: [PATCH] request.security in a function called from several places:
 one slice per call site

---
 src/namespaces/request/methods/security.ts    | 12 ++++-
 .../request/methods/security_lower_tf.ts      | 10 +++-
 src/transpiler/slicing/buildLtfSlices.ts      | 52 ++++++++++++++++++-
 .../request-lower-tf-slicing.test.ts          | 52 +++++++++++++++++--
 4 files changed, 116 insertions(+), 10 deletions(-)

diff --git a/src/namespaces/request/methods/security.ts b/src/namespaces/request/methods/security.ts
index b3e81e6..cf59675 100644
--- a/src/namespaces/request/methods/security.ts
+++ b/src/namespaces/request/methods/security.ts
@@ -328,10 +328,18 @@ export function security(context: any) {
         // available.
         const exprNameStr = typeof _expression_name === 'string' ? _expression_name : '';
         const sliceKey = exprNameStr.match(/p\d+$/)?.[0] ?? exprNameStr;
-        const slice = (context as any)._ltfTruncatedBodies?.[sliceKey];
-        const secContext = slice
+        // A function called from several places has one slice per call site,
+        // keyed by the full `<callsiteId>pN` name; prefer it over the bare `pN`
+        // slice, which only reaches the function's first call.
+        const bodies = (context as any)._ltfTruncatedBodies;
+        const slice = bodies?.[exprNameStr] ?? bodies?.[sliceKey];
+        let secContext = slice
             ? await pineTS.runPretranspiled(slice)
             : await pineTS.run(context.pineTSCode);
+        // A slice that never reached this call site: run the full script instead.
+        if (slice && secContext.params?.[_expression_name] === undefined) {
+            secContext = await pineTS.run(context.pineTSCode);
+        }
 
         context.cache[cacheKey] = { pineTS, context: secContext, dataVersion: context.dataVersion };
 
diff --git a/src/namespaces/request/methods/security_lower_tf.ts b/src/namespaces/request/methods/security_lower_tf.ts
index 6bfec6e..74e6dc9 100644
--- a/src/namespaces/request/methods/security_lower_tf.ts
+++ b/src/namespaces/request/methods/security_lower_tf.ts
@@ -415,10 +415,18 @@ export function security_lower_tf(context: any) {
                 // the trailing `pN` for the lookup.
                 const exprNameStr = typeof _expression_name === 'string' ? _expression_name : '';
                 const sliceKey = exprNameStr.match(/p\d+$/)?.[0] ?? exprNameStr;
-                const slice = (context as any)._ltfTruncatedBodies?.[sliceKey];
+                // Prefer the per-call-site slice (`<callsiteId>pN`) of a function
+                // called from several places; the bare `pN` slice only reaches
+                // its first call.
+                const bodies = (context as any)._ltfTruncatedBodies;
+                const slice = bodies?.[exprNameStr] ?? bodies?.[sliceKey];
                 let secContext: any;
                 if (slice) {
                     secContext = await pineTS.runPretranspiled(slice);
+                    // A slice that never reached this call site: run the full script instead.
+                    if (secContext.params?.[_expression_name] === undefined) {
+                        secContext = await pineTS.run(context.pineTSCode);
+                    }
                 } else {
                     secContext = await pineTS.run(context.pineTSCode);
                 }
diff --git a/src/transpiler/slicing/buildLtfSlices.ts b/src/transpiler/slicing/buildLtfSlices.ts
index d2c4d5d..ec5c7da 100644
--- a/src/transpiler/slicing/buildLtfSlices.ts
+++ b/src/transpiler/slicing/buildLtfSlices.ts
@@ -211,6 +211,37 @@ function findEarliestInvocationIdx(wrapperBody: any, fnName: string, fnDeclNode:
     return -1;
 }
 
+/**
+ * Every `$.call(<fnName>, "<callsiteId>", …)` in a top-level statement,
+ * with the index of that statement. The callsite id is what `$.call`
+ * pushes onto the call stack, so for a top-level invocation it is the
+ * whole runtime `$$.id` inside the function.
+ */
+function findTopLevelInvocations(wrapperBody: any, fnName: string, fnDeclNode: any): Array<{ callsiteId: string; stmtIdx: number }> {
+    const found: Array<{ callsiteId: string; stmtIdx: number }> = [];
+    const stmts: any[] = wrapperBody.body || [];
+    for (let i = 0; i < stmts.length; i++) {
+        if (stmts[i] === fnDeclNode) continue;
+        const seen = new WeakSet<object>();
+        const walk = (n: any) => {
+            if (!n || typeof n !== 'object' || seen.has(n)) return;
+            seen.add(n);
+            if (dollarCallTarget(n) === fnName) {
+                const id = n.arguments?.[1];
+                if (id?.type === 'Literal' && typeof id.value === 'string') found.push({ callsiteId: id.value, stmtIdx: i });
+            }
+            for (const key of Object.keys(n)) {
+                if (AST_SKIP_KEYS.has(key)) continue;
+                const v = n[key];
+                if (Array.isArray(v)) v.forEach(walk);
+                else if (v && typeof v === 'object') walk(v);
+            }
+        };
+        walk(stmts[i]);
+    }
+    return found;
+}
+
 function subtreeContainsDollarCall(root: any, fnName: string): boolean {
     let found = false;
     const seen = new WeakSet<object>();
@@ -258,7 +289,7 @@ function subtreeContainsDollarCall(root: any, fnName: string): boolean {
  * truncate, etc.). Falling back is always safe — the runtime uses
  * the legacy full-script slow path when no slice is registered.
  */
-function buildPhase3SliceStmts(wrapperBody: any, path: any[]): any[] | null {
+function buildPhase3SliceStmts(wrapperBody: any, path: any[], atInvocationIdx?: number): any[] | null {
     // path[0] === wrapperBody. Find the FIRST FunctionDeclaration
     // on the path — that's the outer-most fn body the call lives in.
     let fnIdx = -1;
@@ -284,7 +315,7 @@ function buildPhase3SliceStmts(wrapperBody: any, path: any[]): any[] | null {
     const slicedFn = sliceAlongPath(fnNode, fnSlicePath, 0);
 
     // Find the earliest top-level invocation of this function.
-    const invIdx = findEarliestInvocationIdx(wrapperBody, fnName, fnNode);
+    const invIdx = atInvocationIdx ?? findEarliestInvocationIdx(wrapperBody, fnName, fnNode);
     if (invIdx < 0) return null;
 
     // Build the wrapper.body slice: keep [0..invIdx] inclusive, with
@@ -359,6 +390,23 @@ export function buildLtfSlices(ast: any): Record<string, Function> {
         } else {
             // Phase 3 path: call lives inside a function body.
             stmts = buildPhase3SliceStmts(wrapperFn.body, path);
+
+            // The function may be called from several top-level statements
+            // (e.g. one per timeframe). Each call runs under its own call-site
+            // id, so the runtime expression name is `<callsiteId>pN`, and the
+            // bare `pN` slice above stops at the EARLIEST invocation: a
+            // secondary for any later call site would never reach it. Add one
+            // slice per call site, ending at the statement that makes it.
+            const fnNode = path.find((n, i) => i > 0 && isFunctionLike(n));
+            const fnName = fnNode?.type === 'FunctionDeclaration' ? fnNode.id?.name : null;
+            if (fnName) {
+                for (const { callsiteId, stmtIdx } of findTopLevelInvocations(wrapperFn.body, fnName, fnNode)) {
+                    const key = callsiteId + exprName;
+                    if (key in slices) continue;
+                    const siteStmts = buildPhase3SliceStmts(wrapperFn.body, path, stmtIdx);
+                    if (siteStmts && siteStmts.length > 0) slices[key] = buildSliceFunction(wrapperFn, siteStmts);
+                }
+            }
         }
         if (!stmts || stmts.length === 0) continue;
 
diff --git a/tests/namespaces/request-lower-tf-slicing.test.ts b/tests/namespaces/request-lower-tf-slicing.test.ts
index d146eaa..755a834 100644
--- a/tests/namespaces/request-lower-tf-slicing.test.ts
+++ b/tests/namespaces/request-lower-tf-slicing.test.ts
@@ -126,7 +126,7 @@ plot(postEma, "postEma")
         expect(src).not.toMatch(/'postEma'/);
     });
 
-    it('Phase 3: param names are stored with their static `pN` form (despite runtime path-prefixing)', () => {
+    it('Phase 3: param names are stored with their static `pN` form, plus one `<callsiteId>pN` per call site', () => {
         const code = `
 //@version=5
 indicator("phase3 key")
@@ -138,10 +138,52 @@ plot(a)
 `;
         const fn = transpile(code) as any;
         const keys = Object.keys(fn._ltfSlices ?? {});
-        expect(keys.length).toBeGreaterThan(0);
-        // Slice keys must be bare `pN` literals — the runtime
-        // strips any path prefix before lookup.
-        for (const k of keys) expect(/^p\d+$/.test(k)).toBe(true);
+        // The bare `pN` key (earliest invocation) and the call site's own
+        // key, matching the runtime's path-prefixed `$$.id + 'pN'` name.
+        expect(keys.filter((k) => /^p\d+$/.test(k)).length).toBe(1);
+        expect(keys.filter((k) => /^_fn\d+p\d+$/.test(k)).length).toBe(1);
+    });
+
+    it('Phase 3: a function called from several statements gets a slice per call site, each reaching its call', () => {
+        const code = `
+//@version=5
+indicator("phase3 multi")
+f(s, tf) =>
+    request.security(s, tf, close)
+a = f(syminfo.tickerid, "240")
+b = f(syminfo.tickerid, "120")
+postEma = ta.ema(close, 50)
+plot(a, "a")
+plot(b, "b")
+`;
+        const fn = transpile(code) as any;
+        const sites = Object.keys(fn._ltfSlices ?? {}).filter((k) => /^_fn\d+p\d+$/.test(k));
+        expect(sites.length).toBe(2);
+        const [first, second] = sites.map((k) => fn._ltfSlices[k].toString());
+        // The first site's slice stops at the first call; the second reaches the second.
+        expect(first).toMatch(/'240'/);
+        expect(first).not.toMatch(/'120'/);
+        expect(second).toMatch(/'120'/);
+        expect(second).not.toMatch(/glb1_postEma/);
+    });
+
+    it('Phase 3: request.security in a function called twice returns values for both calls', async () => {
+        const bars = Array.from({ length: 60 }, (_, i) => {
+            const t = Date.UTC(2024, 0, 1) + i * 3600e3;
+            return { openTime: t, closeTime: t + 3600e3, open: i, high: i, low: i, close: i, volume: 1 };
+        });
+        const pineTS = new PineTS(bars, 'BTCUSDT', '60');
+        const ctx = await pineTS.run(`
+//@version=5
+indicator("phase3 twice")
+f(s, tf) =>
+    request.security(s, tf, close)
+plot(f("BTCUSDT", "240"), "a")
+plot(f("BTCUSDT", "120"), "b")
+`);
+        const valued = (k: string) => ctx.plots[k].data.filter((p: any) => Number.isFinite(p.value)).length;
+        expect(valued('a')).toBeGreaterThan(0);
+        expect(valued('b')).toBeGreaterThan(0);
     });
 
     // ─────────────────────────────────────────────────────────────────────
